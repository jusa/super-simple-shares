[Unit]
Description=Super Simple Shares (Gunicorn)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/super-simple-shares
Environment=FILE_SHARE_CONFIG=/opt/super-simple-shares/config.ini
ExecStart=/bin/sh /opt/super-simple-shares/systemd/run-gunicorn.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
