# [server]
# port = 5555
# host = 0.0.0.0
# db = file_share.db
# Omit db to leave download logging off. No database file is created.
# Extra keys are strings you can insert with $KEY in db and in share sections.
# ROOT = /home/foo/bar
# db = $ROOT/my_db.db
# secret = long-random-string
# cookie_lifetime = 7d
# cookie_lifetime = 12h
# name = My file sharing
# footer = <a href="https://github.com/...">project</a> (c) 2026 Name  (HTML allowed)

# Each section is a filesystem path to share. URL path uses a slug from the directory name
# or from "name" (e.g. name = pretty name -> slug "pretty-name"). No two shares can have the same slug.
# If name (or footer etc.) contains # or ;, put the value in double quotes: name = "My Share #2"
# Option "public": if true, no auth. If false, use credentials.N = user:password
# The password may instead be a SHA-256 hash, so the plain password is not stored:
#   sha256:<64 hex chars>                         unsalted hash of the UTF-8 password
#   sha256:<salt hex>:<64 hex chars>              salted, hash is SHA-256(salt bytes + password)
#   python3 -c "import hashlib,secrets; s=secrets.token_hex(16); print('sha256:'+s+':'+hashlib.sha256(bytes.fromhex(s)+b'the-password').hexdigest())"
# Browsers get an HTML login form. The session cookie can hold logins for several shares at once.
# If "secret" is omitted and db is set, a secret is generated once and stored in the database.
# If both are omitted, a new random secret is used on each start, and login cookies do not survive a restart.
# Option "hidden": if true, share is not shown on the root listing but is reachable by direct URL
# [$ROOT/share-1]
# public = true

[/home/user/directory]
public = true

[/home/user/private_directory]
name = Private files
public = false
credentials.1 = user:password
credentials.2 = other:something_else
